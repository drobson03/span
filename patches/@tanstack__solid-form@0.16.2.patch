+import { assertType, it } from 'vitest';
+import { createForm } from '../createForm';
+it('should type state.value properly', () => {
+    function Comp() {
+        const form = createForm(() => ({
+            defaultValues: {
+                firstName: 'test',
+                age: 84,
+            },
+        }));
+        return (<>
+        <form.Field name="firstName" children={(field) => {
+                assertType(field().state.value);
+                return null;
+            }}/>
+        <form.Field name="age" children={(field) => {
+                assertType(field().state.value);
+                return null;
+            }}/>
+      </>);
+    }
+});
+it('should type onChange properly', () => {
+    function Comp() {
+        const form = createForm(() => ({
+            defaultValues: {
+                firstName: 'test',
+                age: 84,
+            },
+        }));
+        return (<>
+        <form.Field name="firstName" validators={{
+                onChange: ({ value }) => {
+                    assertType(value);
+                    return null;
+                },
+            }} children={() => null}/>
+        <form.Field name="age" validators={{
+                onChange: ({ value }) => {
+                    assertType(value);
+                    return null;
+                },
+            }} children={() => null}/>
+      </>);
+    }
+});
