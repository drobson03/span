DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production origin, shared across production, previews, and local development.
OAUTH_PROXY_PRODUCTION_URL=https://your-production-domain.example
# Generate a dedicated secret (at least 32 characters); use the same value everywhere.
OAUTH_PROXY_SECRET=
# Comma-separated origins allowed to receive OAuth callbacks. Configure on production too.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
