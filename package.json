{
  "name": "span",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/dev.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server/node.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/server/migrate.ts",
    "deploy": "alchemy deploy",
    "dev:cloud": "alchemy dev",
    "format": "prettier --write .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "db:adopt": "node --env-file-if-exists=.env --import tsx src/server/migrate.ts --adopt-existing"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@foldkit/ui": "0.165.0",
    "@yielded/auth": "0.1.0-beta.12",
    "@yielded/auth-crypto": "0.1.0-beta.12",
    "@yielded/auth-openid-client": "0.1.0-beta.12",
    "@yielded/auth-persistence": "0.1.0-beta.12",
    "@yielded/auth-persistence-drizzle": "0.1.0-beta.12",
    "alchemy": "2.0.0-beta.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "foldkit": "0.165.0",
    "lucide": "^0.575.0",
    "nanoid": "^5.1.6",
    "openid-client": "^6.8.8",
    "pg": "^8.16.3",
    "tailwind-merge": "^3.5.0",
    "tldts": "^7.4.11"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@electric-sql/pglite": "^0.5.0",
    "@electric-sql/pglite-socket": "0.2.11",
    "@foldkit/vite-plugin": "0.26.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^25.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxlint": "1.86.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "7.12.2",
    "vite": "^8.0.0",
    "vitest": "5.0.3"
  }
}
