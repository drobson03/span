{
  "include": [
    "src/**/*.ts",
    "alchemy.run.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "test/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./src/*"], "~/*": ["./src/*"] }
  }
}
